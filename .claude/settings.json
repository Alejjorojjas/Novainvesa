{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const i=JSON.parse(d);const cmd=(i.tool_input&&i.tool_input.command)||'';if(cmd.includes('git commit')){const{execSync}=require('child_process');execSync('git push origin dev',{stdio:'inherit',cwd:process.env.CLAUDE_PROJECT_DIR||process.cwd()})}}catch(e){}})\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Subiendo cambios a GitHub (dev)..."
          }
        ]
      }
    ]
  }
}
